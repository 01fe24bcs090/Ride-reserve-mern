rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function role() {
      return signedIn() 
        ? (request.auth.token.get("role", 
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "none")
              : "none"
          ))
        : "none";
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isDriver() {
      return role() == "driver";
    }

    function validOwnerUserCreate(uid) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "phone",
          "age",
          "role",
          "assignedBovId",
          "fcmToken",
          "active",
          "createdAt",
          "updatedAt",
          "lastLoginAt"
        ])
        && request.resource.data.uid == uid
        && (request.resource.data.role == "passenger" || request.resource.data.role == "driver")
        && request.resource.data.assignedBovId == null
        && request.resource.data.active == true;
    }

    function validOwnerUserUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "email",
          "phone",
          "age",
          "fcmToken",
          "updatedAt",
          "lastLoginAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.assignedBovId == resource.data.assignedBovId
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && validOwnerUserCreate(uid));
      allow update: if isAdmin() || (isOwner(uid) && validOwnerUserUpdate(uid));
      allow delete: if isAdmin();
    }

    match /users/{uid}/loginHistory/{entryId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
    }

    match /bovs/{bovId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      // Direct create is allowed for client-side allocation (Spark Plan compatibility)
      allow create: if signedIn() && request.resource.data.passengerId == request.auth.uid;
      
      // Read is restricted to the passenger, the assigned driver, or drivers looking at pending rides
      allow read: if signedIn() && (
        isAdmin() 
        || (resource != null && resource.data.passengerId == request.auth.uid)
        || (resource != null && resource.data.acceptedBy == request.auth.uid)
        || (isDriver() && resource.data.rideStatus == "pending")
      );

      allow list: if signedIn();

      allow update: if signedIn() && (
        isAdmin() 
        || (isDriver() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rideStatus", "acceptedBy", "bovId", "bovVehicleNumber"]))
        || (resource.data.passengerId == request.auth.uid && request.resource.data.rideStatus == "cancelled" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rideStatus"]))
      );
      allow delete: if isAdmin();
    }

    match /trains/{trainNumber} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /platforms/{platformId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /peakHours/{peakHourId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /analytics/{docPath=**} {
      allow read: if signedIn() && (isAdmin() || isDriver());
      allow write: if isAdmin();
    }
  }
}
