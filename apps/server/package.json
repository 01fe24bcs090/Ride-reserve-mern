{
  "name": "@ride-reserve/server",
  "version": "1.0.0",
  "description": "Express + MongoDB Backend for Ride Reserve",
  "main": "dist/apps/server/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/apps/server/src/index.js",
